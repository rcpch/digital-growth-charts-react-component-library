#!/usr/bin/env bash
#
# Run Storybook locally for visual review. Pass Storybook options directly,
# for example: s/storybook --port 6007 or s/storybook --no-open.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v npm >/dev/null 2>&1; then
    echo "npm is required; install the repository's Node.js toolchain first." >&2
    exit 1
fi

exec npm run storybook -- "$@"
