#!/usr/bin/env bash
#
# Run the complete Jest test suite. Pass Jest options directly, for example:
# s/test --runInBand or s/test --runInBand RCPCHChart.provenance.test.tsx.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v npm >/dev/null 2>&1; then
    echo "npm is required; install the repository's Node.js toolchain first." >&2
    exit 1
fi

exec npm test -- "$@"
