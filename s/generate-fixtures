#!/usr/bin/env bash
#
# Regenerate the typed measurement fixtures from a running provenance-aware
# digital-growth-charts-server. The API defaults to http://127.0.0.1:8000;
# pass --api-base-url or set FIXTURE_API_BASEURL to use another local instance.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v node >/dev/null 2>&1; then
    echo "node is required; install the repository's Node.js toolchain first." >&2
    exit 1
fi

exec node fixture-generation/generate-fixtures.mjs "$@"
