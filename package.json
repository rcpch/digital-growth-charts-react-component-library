{
    "name": "@rcpch/digital-growth-charts-react-component-library",
    "version": "7.5.0",
    "description": "A React component library for the RCPCH digital growth charts using Rollup, TypeScript and Styled-Components",
    "main": "build/index.js",
    "module": "build/esm.index.js",
    "types": "build/index.d.ts",
    "unpkg": "build/umd/rcpch-digital-growth-charts.umd.min.js",
    "jsdelivr": "build/umd/rcpch-digital-growth-charts.umd.min.js",
    "files": [
        "build"
    ],
    "scripts": {
        "test": "jest --env=jsdom",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=5120 ROLLUP_WATCH=false rollup -c --bundleConfigAsCjs",
        "generate-sri": "cat build/rcpch-digital-growth-charts.umd.min.js | openssl dgst -sha384 -binary | openssl base64 -A",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prettier:check": "prettier --check .",
        "prettier:write": "prettier --write ."
    },
    "keywords": [
        "Growth",
        "Charts",
        "React",
        "Component",
        "Library",
        "Rollup",
        "Typescript",
        "Styled-Components",
        "Jest",
        "Storybook",
        "CDN"
    ],
    "author": "eatyourpeas",
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "react": "^19.1.0 || ^18.3.1",
        "react-dom": "^19.1.0 || ^18.3.1"
    },
    "dependencies": {
        "styled-components": "6.1.19",
        "victory": "37.3.6"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.28.0",
        "@babel/preset-react": "^7.27.1",
        "@babel/preset-typescript": "^7.27.1",
        "@rollup/plugin-alias": "^5.1.1",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-image": "^3.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.4",
        "@rollup/plugin-url": "^8.0.2",
        "@storybook/addon-docs": "^9.1.5",
        "@storybook/addon-links": "^9.1.5",
        "@storybook/addon-onboarding": "^9.1.5",
        "@storybook/addon-styling-webpack": "^2.0.0",
        "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
        "@storybook/preset-scss": "^1.0.3",
        "@storybook/react-webpack5": "^9.1.5",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.1.8",
        "@types/styled-components": "^5.1.34",
        "autoprefixer": "^10.4.21",
        "chromatic": "^13.1.2",
        "cross-env": "^7.0.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-storybook": "^9.1.5",
        "jest": "^30.0.5",
        "jest-environment-jsdom": "^30.0.5",
        "prettier": "^3.6.2",
        "rollup": "^4.45.1",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-dts": "^6.2.1",
        "rollup-plugin-import-css": "^4.0.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-version-injector": "^1.3.3",
        "sass": "^1.89.2",
        "sass-loader": "^16.0.5",
        "storybook": "^9.1.5",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.8.3"
    }
}
