{
    "name": "@rcpch/digital-growth-charts-react-component-library",
    "version": "7.7.0",
    "description": "A React component library for the RCPCH digital growth charts using Rollup, TypeScript and Styled-Components",
    "main": "build/index.js",
    "module": "build/esm.index.js",
    "types": "build/index.d.ts",
    "unpkg": "build/umd/rcpch-digital-growth-charts.umd.min.js",
    "jsdelivr": "build/umd/rcpch-digital-growth-charts.umd.min.js",
    "files": [
        "build"
    ],
    "scripts": {
        "test": "jest --env=jsdom",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=5120 ROLLUP_WATCH=false rollup -c",
        "generate-sri": "cat build/rcpch-digital-growth-charts.umd.min.js | openssl dgst -sha384 -binary | openssl base64 -A",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "prettier:check": "prettier --check .",
        "prettier:write": "prettier --write ."
    },
    "keywords": [
        "Growth",
        "Charts",
        "React",
        "Component",
        "Library",
        "Rollup",
        "Typescript",
        "Styled-Components",
        "Jest",
        "Storybook",
        "CDN"
    ],
    "author": "eatyourpeas",
    "license": "AGPL-3.0-or-later",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.0.0",
            "onFail": "error"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rcpch/digital-growth-charts-react-component-library"
    },
    "peerDependencies": {
        "react": "^19.1.0 || ^18.3.1",
        "react-dom": "^19.1.0 || ^18.3.1"
    },
    "dependencies": {
        "styled-components": "^6.4.1",
        "victory": "37.3.6"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@rollup/plugin-alias": "^6.0.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-image": "^3.0.3",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.4",
        "@rollup/plugin-url": "^8.0.2",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
        "@storybook/react-webpack5": "^10.6.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.7",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.3.0",
        "@types/styled-components": "^5.1.34",
        "autoprefixer": "^10.6.1",
        "chromatic": "^18.9.4",
        "cross-env": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "eslint-plugin-storybook": "^10.6.0",
        "jest": "^30.0.5",
        "jest-environment-jsdom": "^30.0.5",
        "prettier": "^3.9.9",
        "rollup": "^4.63.4",
        "rollup-plugin-dts": "^6.2.1",
        "rollup-plugin-import-css": "^4.0.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-version-injector": "^1.3.3",
        "sass": "^1.104.1",
        "sass-loader": "^17.0.1",
        "storybook": "^10.6.0",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    }
}
